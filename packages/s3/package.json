{
  "name": "@cloudbitmaps/s3",
  "version": "0.9.0",
  "description": "S3 and S3-compatible storage (R2, MinIO, Ceph, Wasabi, B2) for CloudBitmaps",
  "keywords": [
    "cloudbitmaps",
    "bitmap",
    "roaring-bitmap",
    "serverless",
    "cloud",
    "typescript",
    "s3",
    "aws",
    "r2",
    "minio",
    "ceph",
    "wasabi",
    "backblaze",
    "object-storage"
  ],
  "license": "Apache-2.0",
  "author": "Sharvil Kadam",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cloudbitmaps/cloudbitmaps.git",
    "directory": "packages/s3"
  },
  "homepage": "https://github.com/cloudbitmaps/cloudbitmaps#readme",
  "bugs": {
    "url": "https://github.com/cloudbitmaps/cloudbitmaps/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "pnpm run build",
    "build": "node ../../scripts/build.mjs"
  },
  "dependencies": {
    "@cloudbitmaps/core": "workspace:^",
    "@aws-sdk/client-s3": ">=3.645.0 <4"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0"
  }
}
