{
  "name": "@cloudbitmaps/core",
  "version": "0.9.0",
  "description": "The codec-agnostic cloud engine behind the @cloudbitmaps family: a RAM cache over write-once .crbm generations in object storage, chunk-skipping intersection, the load-and-publish write path, generation GC, erasure by rewrite, encryption-at-rest, and every storage driver.",
  "keywords": [
    "roaring",
    "bitmap",
    "roaring-bitmap",
    "roaring-bitmaps",
    "croaring",
    "bitset",
    "compressed-bitmap",
    "lambda",
    "nodejs",
    "typescript",
    "set",
    "set-intersection",
    "s3",
    "gcs",
    "azure",
    "serverless",
    "object-storage",
    "scale-to-zero",
    "segmentation",
    "audience",
    "cloud"
  ],
  "license": "Apache-2.0",
  "author": "Sharvil Kadam",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cloudbitmaps/cloudbitmaps.git"
  },
  "homepage": "https://github.com/cloudbitmaps/cloudbitmaps#readme",
  "bugs": {
    "url": "https://github.com/cloudbitmaps/cloudbitmaps/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./s3": {
      "types": "./dist/s3/index.d.ts",
      "default": "./dist/s3/index.js"
    },
    "./gcs": {
      "types": "./dist/gcs/index.d.ts",
      "default": "./dist/gcs/index.js"
    },
    "./azure": {
      "types": "./dist/azure/index.d.ts",
      "default": "./dist/azure/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "pnpm run build",
    "build": "node ../../scripts/build.mjs"
  },
  "peerDependencies": {
    "@aws-sdk/client-s3": "^3",
    "@azure/storage-blob": "^12",
    "@google-cloud/storage": "^7 || ^8"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-s3": {
      "optional": true
    },
    "@azure/storage-blob": {
      "optional": true
    },
    "@google-cloud/storage": {
      "optional": true
    }
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1132.0",
    "@azure/storage-blob": "^12",
    "@google-cloud/storage": "^8.1.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0"
  }
}
