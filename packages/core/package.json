{
  "name": "@cloudbitmaps/core",
  "version": "0.21.0",
  "description": "Internal engine of CloudBitmaps, used by @cloudbitmaps/roaring and the storage-driver packages. Its main entry is outside the stability promise; the public contract for writing a driver is @cloudbitmaps/core/driver-kit. No cloud SDK.",
  "keywords": [
    "roaring",
    "bitmap",
    "roaring-bitmap",
    "roaring-bitmaps",
    "croaring",
    "bitset",
    "compressed-bitmap",
    "lambda",
    "nodejs",
    "typescript",
    "set",
    "set-intersection",
    "serverless",
    "object-storage",
    "scale-to-zero",
    "segmentation",
    "audience",
    "cloud"
  ],
  "license": "Apache-2.0",
  "author": "Sharvil Kadam",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cloudbitmaps/cloudbitmaps.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/cloudbitmaps/cloudbitmaps#readme",
  "bugs": {
    "url": "https://github.com/cloudbitmaps/cloudbitmaps/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "sideEffects": false,
  "cloudbitmaps": {
    "internalEntries": [
      "."
    ]
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./driver-kit": {
      "types": "./dist/driver-kit.d.ts",
      "default": "./dist/driver-kit.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "pnpm run build",
    "build": "node ../../scripts/build.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0"
  },
  "typesVersions": {
    "*": {
      "driver-kit": [
        "./dist/driver-kit.d.ts"
      ]
    }
  }
}
