{
  "name": "@cloudbitmaps/roaring",
  "version": "0.9.0",
  "description": "Distributed, cloud-native Roaring Bitmaps — query and intersect billion-scale integer sets over tiered cloud storage (RAM → NoSQL → object store), at a fraction of an always-on cache.",
  "keywords": [
    "roaring",
    "bitmap",
    "roaring-bitmap",
    "roaring-bitmaps",
    "croaring",
    "bitset",
    "compressed-bitmap",
    "lambda",
    "nodejs",
    "typescript",
    "set",
    "set-intersection",
    "s3",
    "dynamodb",
    "gcs",
    "azure",
    "mariadb",
    "serverless",
    "tiered-storage",
    "scale-to-zero",
    "segmentation",
    "audience",
    "cloud",
    "cloud-roaring",
    "cloudbitmaps"
  ],
  "license": "Apache-2.0",
  "author": "Sharvil Kadam",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cloudbitmaps/cloudbitmaps.git"
  },
  "homepage": "https://github.com/cloudbitmaps/cloudbitmaps#readme",
  "bugs": {
    "url": "https://github.com/cloudbitmaps/cloudbitmaps/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./s3": {
      "types": "./dist/s3/index.d.ts",
      "import": "./dist/s3/index.js",
      "require": "./dist/s3/index.cjs"
    },
    "./dynamodb": {
      "types": "./dist/dynamodb/index.d.ts",
      "import": "./dist/dynamodb/index.js",
      "require": "./dist/dynamodb/index.cjs"
    },
    "./gcs": {
      "types": "./dist/gcs/index.d.ts",
      "import": "./dist/gcs/index.js",
      "require": "./dist/gcs/index.cjs"
    },
    "./azure": {
      "types": "./dist/azure/index.d.ts",
      "import": "./dist/azure/index.js",
      "require": "./dist/azure/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "PRIVACY.md",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "export-segments": "./dist/bin/export-segments.js"
  },
  "scripts": {
    "prepack": "pnpm run build",
    "build": "tsup"
  },
  "dependencies": {
    "@cloudbitmaps/core": "workspace:*",
    "roaring": "^2.7.0"
  },
  "peerDependencies": {
    "@aws-sdk/client-dynamodb": "^3",
    "@aws-sdk/client-s3": "^3",
    "@azure/storage-blob": "^12",
    "@google-cloud/storage": "^7"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-dynamodb": {
      "optional": true
    },
    "@aws-sdk/client-s3": {
      "optional": true
    },
    "@azure/storage-blob": {
      "optional": true
    },
    "@google-cloud/storage": {
      "optional": true
    }
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "^3.1075.0",
    "@aws-sdk/client-s3": "^3.1075.0",
    "@azure/storage-blob": "^12",
    "@google-cloud/storage": "^7.0.0",
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0"
  }
}
