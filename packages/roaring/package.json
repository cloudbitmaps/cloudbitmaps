{
  "name": "@cloudbitmaps/roaring",
  "version": "0.9.0",
  "description": "Distributed, cloud-native Roaring Bitmaps — query and intersect billion-scale integer sets straight out of object storage, from a bounded RAM cache over immutable objects in your own bucket, at a fraction of an always-on cache.",
  "keywords": [
    "roaring",
    "bitmap",
    "roaring-bitmap",
    "roaring-bitmaps",
    "croaring",
    "bitset",
    "compressed-bitmap",
    "lambda",
    "nodejs",
    "typescript",
    "set",
    "set-intersection",
    "s3",
    "gcs",
    "azure",
    "serverless",
    "object-storage",
    "scale-to-zero",
    "segmentation",
    "audience",
    "cloud",
    "cloud-roaring",
    "cloudbitmaps"
  ],
  "license": "Apache-2.0",
  "author": "Sharvil Kadam",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cloudbitmaps/cloudbitmaps.git",
    "directory": "packages/roaring"
  },
  "homepage": "https://github.com/cloudbitmaps/cloudbitmaps#readme",
  "bugs": {
    "url": "https://github.com/cloudbitmaps/cloudbitmaps/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "PRIVACY.md",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "export-segments": "./dist/bin/export-segments.js"
  },
  "scripts": {
    "prepack": "pnpm run build",
    "build": "node ../../scripts/build.mjs"
  },
  "dependencies": {
    "@cloudbitmaps/core": "workspace:^",
    "roaring": "2.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0"
  }
}
