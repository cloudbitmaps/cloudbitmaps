{
  "name": "@cloudbitmaps/gcs",
  "version": "0.9.0",
  "description": "Google Cloud Storage for CloudBitmaps",
  "keywords": [
    "cloudbitmaps",
    "bitmap",
    "roaring-bitmap",
    "serverless",
    "cloud",
    "typescript",
    "gcs",
    "google-cloud",
    "google-cloud-storage",
    "object-storage"
  ],
  "license": "Apache-2.0",
  "author": "Sharvil Kadam",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cloudbitmaps/cloudbitmaps.git"
  },
  "homepage": "https://github.com/cloudbitmaps/cloudbitmaps#readme",
  "bugs": {
    "url": "https://github.com/cloudbitmaps/cloudbitmaps/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "pnpm run build",
    "build": "node ../../scripts/build.mjs"
  },
  "dependencies": {
    "@cloudbitmaps/core": "workspace:^",
    "@google-cloud/storage": "^7 || ^8"
  },
  "devDependencies": {
    "@google-cloud/storage": "^8.1.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0"
  }
}
