# OS / editor
.DS_Store
*.swp
.idea/
.vscode/

# Env / secrets
.env
.env.*
!.env.example

# Node
node_modules/
# Sibling working trees, kept inside the repo so one project is one folder. Each holds a different
# commit and its own node_modules, so every tool that walks the tree must skip it — see the matching
# entries in eslint.config.js, .prettierignore, tsconfig.json and tests/docs/internal-citations.test.ts.
.worktrees/
dist/
build/
coverage/
*.log
*.tsbuildinfo
*.tgz
.turbo/
.vitest/

# Fuzzing (T3): generated seed corpus + evolved inputs + crash artifacts + the fuzz-only build are not
# committed. Crash reproducers are promoted by hand into tests/core/crbm/fuzz-corpus/ as permanent regressions.
fuzz/corpus/
fuzz/crashes/
fuzz/build/

# Mutation testing (T2): the per-mutant HTML/JSON report + Stryker's temp dir are generated, not committed.
reports/
.stryker-tmp/
dist-lambda/

# transient tarball staging for the Lambda deployability checks
.pack-tmp/
.rss-stage/

# Leak-scan needles that must never be committed (an employer name, a real address, a former handle).
# `pnpm leak-scan` reads one case-insensitive regex per line; putting them in the script would be the leak.
.leak-needles

# libFuzzer/jazzer OOM + crash artifacts land in the CWD as `oom-<sha1>` / `crash-<sha1>`; one was accidentally
# committed during the RSS-gate work. They are reproducers, not source — promote a real one into
# tests/core/crbm/fuzz-corpus/ by hand instead.
oom-*
crash-*

# Real-cloud calibration: a REHEARSAL against MinIO writes its own file, and it is not committed — it proves the
# harness, not the figures. A real run writes `bench/calibration/<runId>.json`, which IS committed with the run: it
# is the evidence. `tests/bench/calibrate-guards.test.ts` asks git whether each is ignored, and checks that the
# harness and the CloudShell script use the same names — so the rule, the harness and the script cannot drift apart.
bench/calibrate-aws-rehearsal.json

# Local review artifact from `pnpm site:screenshots` — regenerable, and 12 MB of PNGs that go stale
# silently: the committed set still showed a tier removed two releases earlier.
.site-screenshots/
